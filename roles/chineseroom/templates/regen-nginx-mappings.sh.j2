#!/bin/sh
set -eu

user_map_file="{{ chineseroom_user_map_file }}"
domain="{{ chineseroom_letsencrypt_domain }}"
sandbox_subdomain="{{ chineseroom_sandbox_subdomain }}"
conf_sandbox_dir="{{ chineseroom_nginx_conf_sandbox_dir }}"

processed_map_file="$conf_sandbox_dir/user-maps.conf"

if ! test -e "$user_map_file"; then
    echo "User map file does not exist: $user_map_file" >&2
    exit 1
fi

if ! test "$domain"; then
    echo "Domain variable is not set or empty: $domain" >&2
    exit 1
fi

echo "# autogenerated by regen-nginx-mappings.sh — do not edit by hand" > "$processed_map_file"

while IFS= read -r line; do
    # Ignore empty lines and comments
    case "$line" in
        ''|'#'*) continue ;;
    esac

    # Split line into subdomain and port
    set -- $line
    subdomain=$1
    port=$2

    # Validate subdomain: only lowercase letters, digits, hyphens; non-empty
    case "$subdomain" in
        *[!a-z0-9-]*|'')
            echo "Skipping invalid subdomain on line: $line" >&2
            continue
            ;;
    esac

    # Validate port: digits only, in the unprivileged range
    case "$port" in
        ''|*[!0-9]*)
            echo "Skipping invalid port on line: $line" >&2
            continue
            ;;
    esac
    if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
        echo "Skipping out-of-range port: $port" >&2
        continue
    fi

    # Append nginx server block to the sandbox config file.
    # proxy_http_version 1.1 ensures correct handling of HTTP/1.1 features
    # (e.g. responses without Content-Length).
    cat >>$processed_map_file <<ENDCONF
server {
    listen 443 ssl;
    server_name $subdomain.$sandbox_subdomain.$domain;
    add_header X-Content-Type-Options "nosniff" always;
    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;

        # WebSocket support:
        proxy_set_header   Upgrade \$http_upgrade;
        proxy_set_header   Connection \$connection_upgrade;

        # Reverse-proxy headers:
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto \$scheme;

        # Avoid buffering and premature timeouts for long-running AI tool responses:
        proxy_read_timeout  3600;
        proxy_send_timeout  3600;
        proxy_buffering     off;
        proxy_cache_bypass  \$http_upgrade;
    }
}
ENDCONF
done < "$user_map_file"

nginx -t && systemctl reload nginx
