# Global TLS and security hardening — included in the http{} context via conf.d/.
#
# Certificate covers:
#   {{ chineseroom_letsencrypt_domain }}
#   *.{{ chineseroom_letsencrypt_domain }}
#   *.{{ chineseroom_sandbox_subdomain }}.{{ chineseroom_letsencrypt_domain }}
ssl_certificate     {{ chineseroom_letsencrypt_base }}/live/{{ chineseroom_letsencrypt_domain }}/fullchain.pem;
ssl_certificate_key {{ chineseroom_letsencrypt_base }}/live/{{ chineseroom_letsencrypt_domain }}/privkey.pem;

# TLS hardening — Mozilla Intermediate compatibility profile
ssl_protocols             TLSv1.2 TLSv1.3;
ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
ssl_prefer_server_ciphers off;
ssl_session_cache         shared:SSL:10m;
ssl_session_timeout       1d;
ssl_session_tickets       off;

# Don't leak nginx version in Server header or error pages
server_tokens off;

# HSTS — 2 years, include subdomains (all subdomains are served via this nginx)
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
